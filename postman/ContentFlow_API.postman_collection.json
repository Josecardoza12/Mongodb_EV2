              "path": [
                "usuarios"
              ],
              "query": [
                {
                  "key": "dispositivo",
                  "value": "Móvil"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Tiene X-Request-ID\", () => pm.response.to.have.header(\"X-Request-ID\"));",
                  "pm.test(\"máx 5 items\", () => pm.expect(pm.response.json().items.length).to.be.at.most(5));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Camila Rojas\",\n  \"correo\": \"{{correoPrueba}}\",\n  \"pais\": \"Chile\",\n  \"genero\": \"Femenino\",\n  \"dispositivo\": \"Móvil\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"correoPrueba\", `camila.${Date.now()}@contentflow.cl`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Tiene X-Request-ID\", () => pm.response.to.have.header(\"X-Request-ID\"));",
                  "const u = pm.response.json();",
                  "pm.collectionVariables.set(\"usuarioId\", u._id);",
                  "pm.test(\"id con formato user_N\", () => pm.expect(u._id).to.match(/^user_\\d+$/));"
                ]
              }
            }
          ]
        },
