{
  "info": {
    "name": "ContentFlow API - EP2 BDY0101",
    "description": "Pruebas de la API REST sobre MongoDB Atlas. Ejecutar en orden con el Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Sistema",
      "item": [
        {
          "name": "Health check (conectividad Atlas)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Tiene X-Request-ID\", () => pm.response.to.have.header(\"X-Request-ID\"));",
                  "pm.test(\"estado ok\", () => pm.expect(pm.response.json().estado).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
